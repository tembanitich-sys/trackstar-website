# Build-time settings only. The site is a static export: nothing here is read at runtime,
# and no secrets belong in this file. (Server settings live in public/api/config.php.)
#
# Use `npm run package:test` or `npm run package:production`, which set these for you.

# Where this build will be hosted (used for social-sharing image URLs). scripts/package.mjs sets
# this from site.config.json; the domain itself is changed there, in one place.
NEXT_PUBLIC_SITE_URL=

# "true" only for the production build: adds the canonical URL and sitemap and lets search
# engines in. Leave unset for the test subdomain and for previews.
NEXT_PUBLIC_INDEXABLE=

# Optional: Cloudflare Turnstile site key (public). Also put the secret in public/api/config.php.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
