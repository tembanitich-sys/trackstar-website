# Canonical origin. Leave unset on previews and local.
NEXT_PUBLIC_SITE_URL=

# Postgres (Neon via the Vercel Marketplace sets this)
DATABASE_URL=

# Email (Resend, verified sending domain send.trackstar.co.zw)
RESEND_API_KEY=
MAIL_FROM="TrackStar <noreply@send.trackstar.co.zw>"
MAIL_TO=info@trackstar.co.zw

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secrets (generate with: openssl rand -base64 32)
IP_HASH_SALT=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
