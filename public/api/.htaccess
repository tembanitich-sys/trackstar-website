# TrackStar API folder. Only enquiry.php and contact.php may be requested from the web;
# configuration, logs, libraries and vendor files are never served.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(enquiry|contact)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(enquiry|contact)\.php$">
        Allow from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "no-store"
</IfModule>
