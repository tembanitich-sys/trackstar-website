# TrackStar website: Apache rules.
# Works on any Apache host that allows .htaccess files (including Hepsia).
# Each block is wrapped so the site still loads if the host lacks that module.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# ---------------------------------------------------------------------------
# One address, always over HTTPS
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # __SITE_DOMAIN__ -> https://www.__SITE_DOMAIN__
    # (scripts/package.mjs fills in the domain from site.config.json when it builds the zip)
    RewriteCond %{HTTP_HOST} ^__SITE_DOMAIN_REGEX__$ [NC]
    RewriteRule ^ https://www.__SITE_DOMAIN__%{REQUEST_URI} [L,R=301]

    # http -> https (also when a front proxy terminates TLS and says so)
    # HTTPS-BEGIN
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # HTTPS-END

    # Files with a fingerprint in their name never change
    RewriteRule ^_next/static/ - [E=TRACKSTAR_IMMUTABLE:1]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
# The Content-Security-Policy allows Cloudflare Turnstile (the optional spam check on the forms).
# 'unsafe-inline' for scripts is needed because the exported pages carry small inline scripts.
<IfModule mod_headers.c>
    # HSTS-BEGIN
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # HSTS-END
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# ---------------------------------------------------------------------------
# Caching: pages are re-checked every visit, assets are kept
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(html|txt|xml|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    Header set Cache-Control "public, max-age=31536000, immutable" env=TRACKSTAR_IMMUTABLE
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Never serve these
# ---------------------------------------------------------------------------
<FilesMatch "(^\.|\.(sql|md|log|bak|ini|sh|lock|example)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Missing pages
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html
